# Copy to .env and fill in. Keep the secrets long and random:
#   openssl rand -base64 32

# The domain that points (DNS A record) at this VPS. Caddy gets a TLS cert for it.
DOMAIN=relay.example.com

# Shared secret the PocketDesk host must present to register a room.
# On the host:  --relay-secret <this>   (or POCKETDESK_RELAY_SECRET)
HOST_SECRET=change-me-host-secret

# coturn static-auth-secret. Must match static-auth-secret in turnserver.conf.
TURN_SECRET=change-me-turn-secret

# ICE servers advertised to both peers. Use your domain.
STUN_URL=stun:relay.example.com:3478
# Plain TURN on 3478 works on most networks. Add turns: on 5349 (TLS) as a
# fallback for networks that block UDP — see turnserver.conf for the cert setup.
TURN_URL=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
